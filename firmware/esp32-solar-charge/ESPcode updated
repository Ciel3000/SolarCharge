const char* SUBSCRIBE_TOPIC_CONTROL = "charger/control/ESP32_CHARGER_STATION_001";
const char* PUBLISH_TOPIC_STATUS = "charger/status/ESP32_CHARGER_STATION_001";

// Hardware Pin Definitions
const int CHARGER_RELAY_PIN_1 = 25;
const int CHARGER_RELAY_PIN_2 = 26;
const int HALL_EFFECT_SENSOR_PIN_1 = 34;
const int HALL_EFFECT_SENSOR_PIN_2 = 35;

// RGB LED Pins (Common Cathode: HIGH = ON)
const int RGB_LED_R_PIN_1 = 18;
const int RGB_LED_G_PIN_1 = 19;
const int RGB_LED_B_PIN_1 = 21;
const int RGB_LED_R_PIN_2 = 22;
const int RGB_LED_G_PIN_2 = 23;
const int RGB_LED_B_PIN_2 = 17;

// ACS712 Sensor Configuration (30A version)
const float VCC_ESP32 = 3.3;
const float SENSOR_SENSITIVITY = 0.066;
float quiescentVoltage1 = VCC_ESP32 / 2.0;
float quiescentVoltage2 = VCC_ESP32 / 2.0;
const float CURRENT_FILTER_ALPHA = 0.15f;           // EMA weight for smoothing
const float SENSOR_IDLE_TOLERANCE_AMPS = 0.08f;     // Max idle drift before recalibration
const unsigned long SENSOR_HEALTH_RECHECK_DELAY_MS = 200;
const unsigned long IDLE_RECALIBRATION_INTERVAL_MS = 600000UL; // 10 minutes
float filteredCurrent[2] = {0.0, 0.0};
unsigned long lastCalibrationTime[2] = {0, 0};

// Relay and Charging State
bool chargerState[2] = {false, false};
float totalMah[2] = {0.0, 0.0};
unsigned long lastMeasurementTime = 0;
const int MEASUREMENT_INTERVAL_MS = 1000;

// Current Thresholds
const float CURRENT_THRESHOLD_AMPS = 0.030;        // Noise floor threshold
const float CHARGING_THRESHOLD_AMPS = 0.100;       // Active charging threshold
const float HIGH_CURRENT_THRESHOLD_AMPS = 1.000;   // High current indicator (fast flash)
const float TRICKLE_CHARGE_THRESHOLD_AMPS = 0.200; // Trickle vs normal charge
const float FULL_CHARGE_CURRENT_DROP = 0.050;      // Current drop to detect full charge

// Auto-off Configuration
const unsigned long AUTO_OFF_TIMEOUT_SECONDS = 60;
unsigned long lastCurrentDetectedTime[2] = {0, 0};

// Charging State Tracking for Full Detection
enum ChargingPhase {
  PHASE_IDLE,
  PHASE_CHARGING,
  PHASE_FULL
};
ChargingPhase chargingPhase[2] = {PHASE_IDLE, PHASE_IDLE};
float peakCurrent[2] = {0.0, 0.0};
unsigned long chargingStartTime[2] = {0, 0};

// RGB Status Configuration
const int RGB_COMMAND_FLASH_DURATION_MS = 500;     // Command acknowledgment flash duration
const unsigned long FULL_CHARGE_HOLD_MS = 60000;   // Hold relay ON for 60s after full detection
enum LedState {
  LED_STATE_AVAILABLE,
  LED_STATE_ACTIVE,
  LED_STATE_FULL,
  LED_STATE_ERROR
};
LedState portLedState[2] = {LED_STATE_AVAILABLE, LED_STATE_AVAILABLE};
bool commandFlashActive[2] = {false, false};
unsigned long commandFlashStart[2] = {0, 0};
bool fullChargeDisconnectPending[2] = {false, false};
unsigned long fullChargeDetectedAt[2] = {0, 0};
bool fullChargeNotificationSent[2] = {false, false};

// Global Objects
WiFiClientSecure espClient;
PubSubClient client(espClient);
WiFiManager wm;
WiFiManagerParameter custom_mqtt_broker("server", "mqtt broker", mqttBroker, 60);
WiFiManagerParameter custom_mqtt_user("user", "mqtt username", mqttUser, 30);
WiFiManagerParameter custom_mqtt_pass("pass", "mqtt password", mqttPassword, 60);

