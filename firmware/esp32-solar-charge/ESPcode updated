float readCurrent(int sensorPin, float quiescentV);
void controlRelay(int portNumber, bool state);
void setup_wifi();
void reconnect_mqtt();
void mqtt_callback(char* topic, byte* payload, unsigned int length);
void publish_status(const char* status_message, int portNumber = -1, const char* eventType = nullptr, const char* eventReason = nullptr);
void publish_consumption(int portNumber, float current, float totalMah);
void setRgbColor(int rPin, int gPin, int bPin, int r, int g, int b);
void refreshPortLed(int portNumber);
void setPortLedState(int portNumber, LedState state);
void triggerCommandFlash(int portNumber);
void startupRgbAnimation();
float filterCurrentReading(int portIdx, float rawCurrent);
bool sensorIdleOffsetExceedsThreshold(int portIdx, float* measuredCurrent = nullptr);
bool calibratePortSensor(int portIdx, bool verbose = true);
bool ensureSensorReadyForActivation(int portNumber);

void setup() {
  Serial.begin(115200);
  Serial.println("ESP32 Charger Station - Enhanced RGB Control");
  Serial.println("============================================");

  // Configure relay pins
  pinMode(CHARGER_RELAY_PIN_1, OUTPUT);
  pinMode(CHARGER_RELAY_PIN_2, OUTPUT);
  digitalWrite(CHARGER_RELAY_PIN_1, LOW);
  digitalWrite(CHARGER_RELAY_PIN_2, LOW);
  chargerState[0] = false;
  chargerState[1] = false;

  // Configure RGB LED pins
  pinMode(RGB_LED_R_PIN_1, OUTPUT);
  pinMode(RGB_LED_G_PIN_1, OUTPUT);
  pinMode(RGB_LED_B_PIN_1, OUTPUT);
  pinMode(RGB_LED_R_PIN_2, OUTPUT);
  pinMode(RGB_LED_G_PIN_2, OUTPUT);
  pinMode(RGB_LED_B_PIN_2, OUTPUT);

  // Startup RGB animation
  startupRgbAnimation();
  setPortLedState(1, LED_STATE_AVAILABLE);
  setPortLedState(2, LED_STATE_AVAILABLE);

  Serial.println("Calibrating sensors (ensure no current flow)...");
  calibrateSensors();
  Serial.println("Calibration complete");

  totalMah[0] = 0.0;
  totalMah[1] = 0.0;
  lastCurrentDetectedTime[0] = millis();
  lastCurrentDetectedTime[1] = millis();
  lastMeasurementTime = millis();

  setup_wifi();
  espClient.setCACert(emqx_ca_cert);
  client.setServer(mqttBroker, mqttPort);
  client.setCallback(mqtt_callback);
  reconnect_mqtt();

  publish_status("online");
  publish_status(chargerState[0] ? "ON" : "OFF", 1);
  publish_status(chargerState[1] ? "ON" : "OFF", 2);

  Serial.println("System ready - Monitoring started");
}

void loop() {
  if (!client.connected()) {
    reconnect_mqtt();
  }
  client.loop();

  // Current measurement and state updates
  if (millis() - lastMeasurementTime >= MEASUREMENT_INTERVAL_MS) {
    lastMeasurementTime = millis();

    // Process both ports
    for (int port = 1; port <= 2; port++) {
      int portIdx = port - 1;
      int sensorPin = (port == 1) ? HALL_EFFECT_SENSOR_PIN_1 : HALL_EFFECT_SENSOR_PIN_2;
      float quiescentV = (port == 1) ? quiescentVoltage1 : quiescentVoltage2;

      if (!chargerState[portIdx] &&
          (millis() - lastCalibrationTime[portIdx]) > IDLE_RECALIBRATION_INTERVAL_MS) {
        Serial.print("Port ");
        Serial.print(port);
        Serial.println(": Auto recalibrating idle sensor");
        calibratePortSensor(portIdx, false);
      }

      float rawCurrent = readCurrent(sensorPin, quiescentV);
      float current = filterCurrentReading(portIdx, rawCurrent);
      float absCurrent = fabs(current);
      if (absCurrent < CURRENT_THRESHOLD_AMPS) {
        absCurrent = 0.0;
      }

      float mahThisInterval = (absCurrent * MEASUREMENT_INTERVAL_MS) / 3600.0;
      if (mahThisInterval > 0.0) {
        totalMah[portIdx] += mahThisInterval;
      }

      // Charging phase detection
      if (chargerState[portIdx]) {
        if (absCurrent >= CHARGING_THRESHOLD_AMPS) {
          if (chargingPhase[portIdx] == PHASE_IDLE) {
            chargingPhase[portIdx] = PHASE_CHARGING;
            chargingStartTime[portIdx] = millis();
            peakCurrent[portIdx] = absCurrent;
            Serial.print("Port ");
            Serial.print(port);
            Serial.println(": Charging started");
          } else if (chargingPhase[portIdx] == PHASE_CHARGING) {
            if (absCurrent > peakCurrent[portIdx]) {
              peakCurrent[portIdx] = absCurrent;
            }
          }
          lastCurrentDetectedTime[portIdx] = millis();
        } else if (chargingPhase[portIdx] == PHASE_CHARGING && 
                   peakCurrent[portIdx] > CHARGING_THRESHOLD_AMPS &&
                   absCurrent < FULL_CHARGE_CURRENT_DROP) {
          // Current dropped significantly after sustained charging = Full
          chargingPhase[portIdx] = PHASE_FULL;
          fullChargeDetectedAt[portIdx] = millis();
          fullChargeDisconnectPending[portIdx] = true;
          if (!fullChargeNotificationSent[portIdx]) {
            publish_status("FULL", port, "PORT_FULL_READY", "FULL_CHARGE");
            fullChargeNotificationSent[portIdx] = true;
          }
          setPortLedState(port, LED_STATE_FULL);
          Serial.print("Port ");
          Serial.print(port);
          Serial.println(": Charging complete (Full)");
        }

        // Auto-off logic
        if (absCurrent <= CURRENT_THRESHOLD_AMPS &&
            chargingPhase[portIdx] != PHASE_FULL &&
            !fullChargeDisconnectPending[portIdx] &&
            (millis() - lastCurrentDetectedTime[portIdx]) > (AUTO_OFF_TIMEOUT_SECONDS * 1000UL)) {
          Serial.print("Port ");
          Serial.print(port);
          Serial.println(": Auto-off timeout");
          controlRelay(port, false);
          const bool reachedFullCharge = (chargingPhase[portIdx] == PHASE_FULL);
          const char* autoOffEvent = reachedFullCharge ? "PORT_AUTO_OFF_FULL" : "PORT_AUTO_OFF_IDLE";
          const char* autoOffReason = reachedFullCharge ? "FULL_CHARGE" : "NO_CURRENT";
          publish_status("OFF", port, autoOffEvent, autoOffReason);
          chargingPhase[portIdx] = PHASE_IDLE;
        }
      }

      if (fullChargeDisconnectPending[portIdx] &&
          chargerState[portIdx] &&
          (millis() - fullChargeDetectedAt[portIdx]) >= FULL_CHARGE_HOLD_MS) {
        Serial.print("Port ");
        Serial.print(port);
        Serial.println(": Full charge hold elapsed, disconnecting");
        controlRelay(port, false);
        publish_status("OFF", port, "PORT_AUTO_OFF_FULL", "FULL_CHARGE");
        chargingPhase[portIdx] = PHASE_IDLE;
        fullChargeDisconnectPending[portIdx] = false;
        fullChargeNotificationSent[portIdx] = false;
      }

      // Ensure LED reflects current port state/command flashes
      refreshPortLed(port);

      Serial.print("Port ");
      Serial.print(port);
      Serial.print(" -> Current: ");
      Serial.print(absCurrent, 3);
      Serial.print("A | mAh: ");
      Serial.print(totalMah[portIdx], 2);
      Serial.print(" | State: ");
      Serial.println(chargerState[portIdx] ? "ON" : "OFF");

      if (chargerState[portIdx]) {
        publish_consumption(port, absCurrent, totalMah[portIdx]);
      }
    }
    Serial.println("---");
  }
}
/**
 * Startup animation: Cycles through RGB colors on both ports
 */
void startupRgbAnimation() {
  Serial.println("Running startup RGB animation...");
  
  int colors[][3] = {
    {255, 0, 0},    // Red
    {0, 255, 0},    // Green
    {0, 0, 255},    // Blue
    {255, 255, 0},  // Yellow
    {0, 255, 255},  // Cyan
    {255, 0, 255},  // Magenta
    {255, 255, 255} // White
  };
  
  for (int i = 0; i < 7; i++) {
    setRgbColor(RGB_LED_R_PIN_1, RGB_LED_G_PIN_1, RGB_LED_B_PIN_1, colors[i][0], colors[i][1], colors[i][2]);
    setRgbColor(RGB_LED_R_PIN_2, RGB_LED_G_PIN_2, RGB_LED_B_PIN_2, colors[i][0], colors[i][1], colors[i][2]);
    delay(150);
  }
  
  // Turn off
  setRgbColor(RGB_LED_R_PIN_1, RGB_LED_G_PIN_1, RGB_LED_B_PIN_1, 0, 0, 0);
  setRgbColor(RGB_LED_R_PIN_2, RGB_LED_G_PIN_2, RGB_LED_B_PIN_2, 0, 0, 0);
  delay(200);
}
/**
 * Sets RGB LED color with 0-255 intensity values
 */
void setRgbColor(int rPin, int gPin, int bPin, int r, int g, int b) {
  analogWrite(rPin, r);
  analogWrite(gPin, g);
  analogWrite(bPin, b);
}
/**
 * Triggers a brief flash animation when command is received
 */
void triggerCommandFlash(int portNumber) {
  int portIdx = portNumber - 1;
  if (portIdx < 0 || portIdx > 1) {
    return;
  }
  commandFlashActive[portIdx] = true;
  commandFlashStart[portIdx] = millis();
  refreshPortLed(portNumber);
}

/**
 * Applies the stored LED state (with command flash override).
 */
void refreshPortLed(int portNumber) {
  int rPin, gPin, bPin;
  int portIdx = portNumber - 1;

  if (portIdx < 0 || portIdx > 1) {
    return;
  }

  if (portNumber == 1) {
    rPin = RGB_LED_R_PIN_1;
    gPin = RGB_LED_G_PIN_1;
    bPin = RGB_LED_B_PIN_1;
  } else if (portNumber == 2) {
    rPin = RGB_LED_R_PIN_2;
    gPin = RGB_LED_G_PIN_2;
    bPin = RGB_LED_B_PIN_2;
  } else {
    return;
  }

  unsigned long currentTime = millis();

  // Command flash override (white flash)
  if (commandFlashActive[portIdx]) {
    if (currentTime - commandFlashStart[portIdx] < RGB_COMMAND_FLASH_DURATION_MS) {
      uint8_t intensity = 255 - ((currentTime - commandFlashStart[portIdx]) * 255 / RGB_COMMAND_FLASH_DURATION_MS);
      setRgbColor(rPin, gPin, bPin, intensity, intensity, intensity);
      return;
    } else {
      commandFlashActive[portIdx] = false;
    }
  }

  switch (portLedState[portIdx]) {
    case LED_STATE_AVAILABLE:
      setRgbColor(rPin, gPin, bPin, 0, 0, 255);
      break;
    case LED_STATE_ACTIVE:
      setRgbColor(rPin, gPin, bPin, 0, 255, 0);
      break;
    case LED_STATE_FULL:
      setRgbColor(rPin, gPin, bPin, 255, 0, 0);
      break;
    case LED_STATE_ERROR:
      setRgbColor(rPin, gPin, bPin, 255, 0, 255);
      break;
  }
}

void setPortLedState(int portNumber, LedState state) {
  int portIdx = portNumber - 1;
  if (portIdx < 0 || portIdx > 1) {
    return;
  }
  if (portLedState[portIdx] != state) {
    portLedState[portIdx] = state;
  }
  refreshPortLed(portNumber);
}

void setup_wifi() {
  Serial.println("Starting WiFiManager...");
  wm.addParameter(&custom_mqtt_broker);
  wm.addParameter(&custom_mqtt_user);
  wm.addParameter(&custom_mqtt_pass);
  wm.setConfigPortalTimeout(120);

  if (!wm.autoConnect("ESP32_Charger_AP", "chargerpass*")) {
    Serial.println("WiFi connection failed - restarting");
    delay(3000);
    ESP.restart();
  }

  Serial.println("WiFi connected");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  strcpy(mqttBroker, custom_mqtt_broker.getValue());
  strcpy(mqttUser, custom_mqtt_user.getValue());
  strcpy(mqttPassword, custom_mqtt_pass.getValue());
}

void reconnect_mqtt() {
  while (!client.connected()) {
    Serial.print("Connecting to MQTT...");

    StaticJsonDocument<150> lwtDoc;
    lwtDoc["status"] = "offline";
    lwtDoc["timestamp"] = millis();
    lwtDoc["port_states"][0]["port_number"] = 1;
    lwtDoc["port_states"][0]["charger_state"] = chargerState[0] ? "ON" : "OFF";
    lwtDoc["port_states"][1]["port_number"] = 2;
    lwtDoc["port_states"][1]["charger_state"] = chargerState[1] ? "ON" : "OFF";
    
    char lwtJsonBuffer[150];
    serializeJson(lwtDoc, lwtJsonBuffer);

    if (client.connect(mqttClientId, mqttUser, mqttPassword, PUBLISH_TOPIC_STATUS, 1, true, lwtJsonBuffer)) {
      Serial.println("connected");
      client.subscribe(SUBSCRIBE_TOPIC_CONTROL);
      publish_status("online");
      publish_status(chargerState[0] ? "ON" : "OFF", 1);
      publish_status(chargerState[1] ? "ON" : "OFF", 2);
    } else {
      Serial.print("failed, rc=");
      Serial.println(client.state());
      delay(5000);
    }
  }
}

void mqtt_callback(char* topic, byte* payload, unsigned int length) {
  Serial.print("MQTT [");
  Serial.print(topic);
  Serial.print("]: ");
  
  for (int i = 0; i < length; i++) {
    Serial.print((char)payload[i]);
  }
  Serial.println();

  StaticJsonDocument<200> doc;
  DeserializationError error = deserializeJson(doc, payload, length);

  if (error) {
    Serial.print("JSON parse error: ");
    Serial.println(error.f_str());
    return;
  }

  if (strcmp(topic, SUBSCRIBE_TOPIC_CONTROL) == 0) {
    int portNumber = doc["port_number"] | 0;
    String command = doc["command"] | "";

    if (portNumber >= 1 && portNumber <= 2) {
      triggerCommandFlash(portNumber); // Flash to acknowledge command
      
      if (command == "ON") {
        Serial.print("Port ");
        Serial.print(portNumber);
        Serial.println(": ON command");
        if (ensureSensorReadyForActivation(portNumber)) {
          controlRelay(portNumber, true);
          publish_status("ON", portNumber);
        } else {
          setPortLedState(portNumber, LED_STATE_ERROR);
          publish_status("ERROR", portNumber, "PORT_SENSOR_FAULT", "SENSOR_UNSTABLE");
        }
      } else if (command == "OFF") {
        Serial.print("Port ");
        Serial.print(portNumber);
        Serial.println(": OFF command");
        controlRelay(portNumber, false);
        publish_status("OFF", portNumber);
      }
    }
  }
}

void calibrateSensors() {
  Serial.println("Ensure no current flows during calibration");
  delay(1500);
  calibratePortSensor(0);
  calibratePortSensor(1);
  totalMah[0] = 0.0;
  totalMah[1] = 0.0;
}

float readCurrent(int sensorPin, float quiescentV) {
  const int numSamples = 1000;
  long sumRawValue = 0;

  for (int i = 0; i < numSamples; i++) {
    sumRawValue += analogRead(sensorPin);
    delayMicroseconds(100);
  }
  
  float avgRawValue = (float)sumRawValue / numSamples;
  float voltage = (avgRawValue / 4095.0) * VCC_ESP32;
  float current = (voltage - quiescentV) / SENSOR_SENSITIVITY;
  return current;
}

float filterCurrentReading(int portIdx, float rawCurrent) {
  filteredCurrent[portIdx] = (CURRENT_FILTER_ALPHA * rawCurrent) +
                             ((1.0f - CURRENT_FILTER_ALPHA) * filteredCurrent[portIdx]);
  return filteredCurrent[portIdx];
}

bool sensorIdleOffsetExceedsThreshold(int portIdx, float* measuredCurrent) {
  int sensorPin = (portIdx == 0) ? HALL_EFFECT_SENSOR_PIN_1 : HALL_EFFECT_SENSOR_PIN_2;
  float quiescent = (portIdx == 0) ? quiescentVoltage1 : quiescentVoltage2;
  float idleCurrent = fabs(readCurrent(sensorPin, quiescent));
  if (measuredCurrent) {
    *measuredCurrent = idleCurrent;
  }
  return idleCurrent > SENSOR_IDLE_TOLERANCE_AMPS;
}

bool calibratePortSensor(int portIdx, bool verbose) {
  int sensorPin = (portIdx == 0) ? HALL_EFFECT_SENSOR_PIN_1 : HALL_EFFECT_SENSOR_PIN_2;
  const int numReadings = 2000;
  long sumRawValue = 0;

  for (int i = 0; i < numReadings; i++) {
    sumRawValue += analogRead(sensorPin);
    delayMicroseconds(150);
  }

  float avgRawValue = (float)sumRawValue / numReadings;
  float voltage = (avgRawValue / 4095.0) * VCC_ESP32;
  if (portIdx == 0) {
    quiescentVoltage1 = voltage;
  } else {
    quiescentVoltage2 = voltage;
  }
  filteredCurrent[portIdx] = 0.0f;
  lastCalibrationTime[portIdx] = millis();

  if (verbose) {
    Serial.print("Sensor ");
    Serial.print(portIdx + 1);
    Serial.print(" recalibrated: ");
    Serial.print(voltage, 4);
    Serial.println("V");
  }
  return true;
}

bool ensureSensorReadyForActivation(int portNumber) {
  int portIdx = portNumber - 1;
  if (portIdx < 0 || portIdx > 1) {
    return false;
  }

  if (chargerState[portIdx]) {
    controlRelay(portNumber, false);
    delay(SENSOR_HEALTH_RECHECK_DELAY_MS);
  }

  float measuredCurrent = 0.0f;
  if (!sensorIdleOffsetExceedsThreshold(portIdx, &measuredCurrent)) {
    return true;
  }

  Serial.print("Port ");
  Serial.print(portNumber);
  Serial.print(": Idle current ");
  Serial.print(measuredCurrent, 3);
  Serial.println("A detected, recalibrating sensor...");

  calibratePortSensor(portIdx);
  delay(SENSOR_HEALTH_RECHECK_DELAY_MS);

  if (sensorIdleOffsetExceedsThreshold(portIdx, &measuredCurrent)) {
    Serial.print("Port ");
    Serial.print(portNumber);
    Serial.print(": Sensor unstable after calibration (");
    Serial.print(measuredCurrent, 3);
    Serial.println("A)");
    return false;
  }

  Serial.print("Port ");
  Serial.print(portNumber);
  Serial.println(": Sensor ready after calibration.");
  return true;
}

void controlRelay(int portNumber, bool state) {
  int relayPin;
  int portIdx = portNumber - 1;
  
  if (portNumber == 1) {
    relayPin = CHARGER_RELAY_PIN_1;
    chargerState[0] = state;
    if (state) {
      lastCurrentDetectedTime[0] = millis();
      chargingPhase[0] = PHASE_IDLE;
      peakCurrent[0] = 0.0;
      fullChargeDisconnectPending[0] = false;
      fullChargeNotificationSent[0] = false;
    }
  } else if (portNumber == 2) {
    relayPin = CHARGER_RELAY_PIN_2;
    chargerState[1] = state;
    if (state) {
      lastCurrentDetectedTime[1] = millis();
      chargingPhase[1] = PHASE_IDLE;
      peakCurrent[1] = 0.0;
      fullChargeDisconnectPending[1] = false;
      fullChargeNotificationSent[1] = false;
    }
  } else {
    return;
  }

  filteredCurrent[portIdx] = 0.0;

  if (!state) {
    chargingPhase[portIdx] = PHASE_IDLE;
    peakCurrent[portIdx] = 0.0;
    filteredCurrent[portIdx] = 0.0;
    fullChargeDisconnectPending[portIdx] = false;
    fullChargeNotificationSent[portIdx] = false;
  }

  digitalWrite(relayPin, state ? HIGH : LOW);
  setPortLedState(portNumber, state ? LED_STATE_ACTIVE : LED_STATE_AVAILABLE);
  
  Serial.print("Port ");
  Serial.print(portNumber);
  Serial.print(" relay: ");
  Serial.println(state ? "ON" : "OFF");
}
void publish_status(const char* status_message, int portNumber, const char* eventType, const char* eventReason) {
  StaticJsonDocument<220> doc;
  doc["timestamp"] = millis();
  char jsonBuffer[220];

  if (portNumber == -1) {
    doc["status"] = status_message;
    doc["port_states"][0]["port_number"] = 1;
    doc["port_states"][0]["charger_state"] = chargerState[0] ? "ON" : "OFF";
    doc["port_states"][1]["port_number"] = 2;
    doc["port_states"][1]["charger_state"] = chargerState[1] ? "ON" : "OFF";
    if (eventType) {
      doc["event_type"] = eventType;
    }
    if (eventReason) {
      doc["reason"] = eventReason;
    }

    serializeJson(doc, jsonBuffer);
    if (client.publish(PUBLISH_TOPIC_STATUS, jsonBuffer)) {
      Serial.print("Published station status: ");
      Serial.println(status_message);
    }
  } else {
    doc["port_number"] = portNumber;
    doc["charger_state"] = (portNumber == 1 ? chargerState[0] : chargerState[1]) ? "ON" : "OFF";
    doc["status"] = status_message;
    if (eventType) {
      doc["event_type"] = eventType;
    }
    if (eventReason) {
      doc["reason"] = eventReason;
    }

    serializeJson(doc, jsonBuffer);
    if (client.publish(PUBLISH_TOPIC_STATUS, jsonBuffer)) {
      Serial.print("Published Port ");
      Serial.print(portNumber);
      Serial.print(" status: ");
      Serial.println(status_message);
    }
  }
}
void publish_consumption(int portNumber, float current, float totalMah) {
  StaticJsonDocument<200> doc;
  doc["device_id"] = mqttClientId;
  doc["port_number"] = portNumber;
  doc["consumption"] = current;
  doc["total_mah"] = totalMah;
  doc["charger_state"] = (portNumber == 1 ? chargerState[0] : chargerState[1]) ? "ON" : "OFF";
  doc["timestamp"] = millis();

  char jsonBuffer[200];
  serializeJson(doc, jsonBuffer);
  client.publish(PUBLISH_TOPIC_USAGE, jsonBuffer);
}