# Copy to .env and fill in values.

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=solar_charge
DB_PORT=3306

# Local JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# EMQX Cloud
EMQX_HOST=
EMQX_PORT=8883
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_CA_CERT=

# Backend MQTT Client ID (must be unique from ESP32 devices)
MQTT_CLIENT_ID=backend-server-001

# Paypal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
WEBHOOK_PAYPAL_URL=
